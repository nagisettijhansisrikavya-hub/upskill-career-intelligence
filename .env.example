# UPSKILL - Environment Configuration
# Copy this file to .env and configure your values

# Port for the Express server
PORT=5000

# Secret key used to sign and verify JSON Web Tokens (JWT)
# In production, replace this with a strong, unpredictable random string
JWT_SECRET=upskill_super_secret_jwt_key_2026

# Token expiration duration (e.g., 7d, 24h, 30d)
JWT_EXPIRES_IN=7d
