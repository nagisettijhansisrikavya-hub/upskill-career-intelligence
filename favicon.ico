<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" width="128" height="128">
  <defs>
    <linearGradient id="brandGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F97316"/>
      <stop offset="50%" stop-color="#E2856E"/>
      <stop offset="100%" stop-color="#EC4899"/>
    </linearGradient>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1E293B"/>
      <stop offset="100%" stop-color="#0B1120"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#F97316" flood-opacity="0.35"/>
    </filter>
  </defs>

  <!-- Background rounded icon card -->
  <rect width="128" height="128" rx="28" fill="#0B1120"/>
  <rect x="4" y="4" width="120" height="120" rx="24" fill="url(#bgGrad)" stroke="rgba(255, 255, 255, 0.12)" stroke-width="2"/>

  <!-- Glowing Accent Graduation Cap Emblem -->
  <g filter="url(#glow)">
    <!-- Cap Diamond (Mortarboard top) -->
    <polygon points="64,28 108,48 64,68 20,48" fill="url(#brandGrad)"/>
    
    <!-- Cap Skullcap underside -->
    <path d="M38,58 L38,78 C38,94 90,94 90,78 L90,58 C82,64 73,67 64,67 C55,67 46,64 38,58 Z" fill="url(#brandGrad)" opacity="0.95"/>
    
    <!-- Tassel Ribbon & Bob -->
    <path d="M102,50 C104,58 108,68 108,76 L112,76 C112,68 106,58 104,50 Z" fill="#F8FAFC"/>
    <circle cx="110" cy="80" r="3.5" fill="#F8FAFC"/>
    <circle cx="64" cy="48" r="3" fill="#FFFFFF" opacity="0.8"/>
  </g>
  
  <!-- Modern Upward Career Arrow Accent -->
  <path d="M54,106 L64,96 L74,106" fill="none" stroke="url(#brandGrad)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.9"/>
</svg>
